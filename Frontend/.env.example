# ─── API Configuration ────────────────────────────────────────────────────────────
# The base URL of the deployed backend API.
# In production, this should point to the deployed backend URL (e.g. https://api.your-domain.com/api/v1)
# If left empty in production, it will default to '/api/v1' and rely on relative routing.
VITE_API_BASE_URL=http://localhost:3000/api/v1
