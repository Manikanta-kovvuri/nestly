# ─── Application ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/nestly?schema=public

# ─── Authentication ───────────────────────────────────────────────────────────────
# Use a long, random string in production (e.g. openssl rand -base64 64)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────────
# Frontend origin — restrict in production (e.g., https://your-production-app.com)
FRONTEND_URL=http://localhost:5173
